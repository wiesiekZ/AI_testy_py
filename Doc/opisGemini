Python
import smtplib
from email.mime.text import MIMEText
from email.mime.multipart import MIMEMultipart

def send_email_report(content):
    # Konfiguracja
    sender_email = "TWOJ_MAIL@gmail.com"
    receiver_email = "ADRES_DOCELOWY@gmail.com"
    app_password = "TWÓJ_KOD_APLIKACJI" # To 16-znakowe hasło od Google

    # Tworzenie wiadomości
    msg = MIMEMultipart()
    msg['From'] = sender_email
    msg['To'] = receiver_email
    msg['Subject'] = f"📊 Raport Giełdowy Orlen - {datetime.now().strftime('%d/%m/%Y')}"

    # Treść maila
    msg.attach(MIMEText(content, 'plain'))

    try:
        # Połączenie z serwerem Gmail (smtp.gmail.com, port 587)
        server = smtplib.SMTP('smtp.gmail.com', 587)
        server.starttls() # Szyfrowanie
        server.login(sender_email, app_password)
        server.send_message(msg)
        server.quit()
        print("✅ Email wysłany pomyślnie!")
    except Exception as e:
        print(f"❌ Błąd wysyłki maila: {e}")

# Wywołanie na końcu skryptu:
if result:
    send_email_report(str(result))
